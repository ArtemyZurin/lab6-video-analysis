      "value": -23.08330683132674,
      "id": "e00011"
    },
    {
      "type": "speech",
      "label": "When something crosses the event horizon, it collapses into the black hole's singularity,",
      "start": 31.14,
      "end": 36.62,
      "avg_logprob": -0.14466432114722025,
      "id": "e00012"
    },
    {
      "type": "speech",
      "label": "an infinitely small, infinitely dense point where space, time, and the laws of physics no longer apply.",
      "start": 36.96,
