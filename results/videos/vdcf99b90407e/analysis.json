    },
    {
      "type": "speech",
      "label": "black holes being the most common.",
      "start": 51.42,
      "end": 53.26,
      "avg_logprob": -0.19645453691482545,
      "id": "e00017"
    },
    {
      "type": "speech",
      "label": "Stellar black holes form when massive stars die and collapse.",
